# Drafts live locally only — the repo is public, and an unpublished argument
# (plus its working notes) is not something to publish by accident.
# Publishing = rename to *.md and set `draft: false`; tools/check-drafts.mjs
# refuses to build if those two ever disagree.
src/content/writing/*.draft.md
