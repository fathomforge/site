---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noindex description="That page doesn't exist.">
  <section class="shell wrap">
    <p class="eyebrow">404</p>
    <h1>Nothing at this depth.</h1>
    <p class="lede">That page doesn't exist, or it moved.</p>
    <a class="link-arrow" href="/">Back to the surface <span>&rarr;</span></a>
  </section>
</Base>
<style>
  .wrap { min-height: 46vh; }
  h1 { margin-bottom: .6rem; }
  .link-arrow { margin-top: 1.5rem; }
</style>
