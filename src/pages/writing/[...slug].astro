---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime, neighbours } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, ...neighbours(posts, post.id) },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);
---
<Base
  title={post.data.title}
  description={post.data.description}
  og={`post-${post.id}`}
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
  noindex={post.data.draft}
>
  <article class="shell">
    <header class="head">
      <p class="eyebrow"><a href="/writing/">Writing</a></p>
      <h1>{post.data.title}</h1>
      <p class="byline">
        Carlos M.
        <a class="byline__note" href="/about/#how-these-are-written">my notes, AI-drafted</a>
      </p>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="dot" aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {post.data.tags.length > 0 && <span class="dot" aria-hidden="true">·</span>}
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </p>
      {post.data.draft && (
        <p class="draft-banner">
          Draft — not published. Visible in local development only.
        </p>
      )}
    </header>

    <div class="prose body">
      <Content />
    </div>

    <footer class="foot-nav">
      <a class="link-arrow back" href="/writing/"><span>&larr;</span> All writing</a>

      {(newer || older) && (
        <nav class="siblings" aria-label="More posts">
          {older ? (
            <a class="sibling" href={`/writing/${older.id}/`} rel="prev">
              <span class="mono-label">Older</span>
              <span class="sibling__title">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer && (
            <a class="sibling sibling--next" href={`/writing/${newer.id}/`} rel="next">
              <span class="mono-label">Newer</span>
              <span class="sibling__title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>
</Base>

<style>
  /* Other pages get their rhythm from <section>; this one wraps in <article>,
     so it has to opt into the same vertical padding or navigating into a post
     jolts against the nav. */
  article.shell { padding-block: clamp(4rem, 9vw, 7.5rem); }
  /* Display type wants a wider column than body copy: the narrow measure that
     keeps prose at ~75 characters breaks headlines into too many lines. */
  .head { max-width: 44rem; }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--accent); }
  h1 { margin-bottom: .55rem; }
  .byline {
    margin: 0 0 .6rem;
    font-family: var(--font-mono);
    font-size: .82rem;
    letter-spacing: .02em;
    color: var(--fg);
  }
  /* Stated plainly and linked rather than buried: being found out is the thing
     that costs credibility, not the disclosure itself. */
  .byline__note {
    color: var(--fg-faint);
    text-decoration: none;
    border-bottom: 1px dotted var(--line-strong);
    padding-bottom: 1px;
  }
  .byline__note::before { content: "· "; border: 0; }
  .byline__note:hover { color: var(--fg-muted); border-bottom-color: var(--accent); }
  .meta {
    display: flex; align-items: center; gap: .6rem; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: .78rem; color: var(--fg-faint);
  }
  .draft-banner {
    margin-top: 1.5rem;
    padding: .7rem 1rem;
    border: 1px solid var(--danger);
    border-radius: var(--radius-sm);
    background: var(--danger-dim);
    color: var(--danger);
    font-family: var(--font-mono);
    font-size: .78rem;
  }
  .body { margin-top: 3rem; padding-bottom: 2rem; }
  .body :global(h2) { margin-top: 2.6rem; }
  .body :global(h3) { margin-top: 2rem; }
  .body :global(blockquote) {
    margin: 1.8rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--fg-muted);
    font-style: italic;
  }
  .body :global(ul), .body :global(ol) { padding-left: 1.25rem; }
  .body :global(li) { margin-bottom: .5rem; }
  .body :global(a) { color: var(--accent); }
  .body :global(table) { border-collapse: collapse; width: 100%; margin: 1.8rem 0; }
  .body :global(th) { text-align: left; font-weight: 500; }
  .body :global(th), .body :global(td) {
    padding: .5rem .9rem .5rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  /* Code is wider than comfortable prose. Let it use the title column's width
     rather than forcing a horizontal scroll to read one identifier. */
  .body :global(pre) {
    margin: 1.8rem 0;
    width: 44rem;
    max-width: calc(100vw - 2 * var(--gutter));
  }
  .body :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    color: var(--fg-muted);
    font-size: .82rem;
  }
  .foot-nav { border-top: 1px solid var(--line); padding-top: 2rem; }
  .back span { display: inline-block; transition: transform .3s var(--ease); }
  .back:hover span { transform: translateX(-4px); }

  .siblings {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .sibling {
    display: flex; flex-direction: column; gap: .4rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color .25s var(--ease);
  }
  .sibling:hover { border-color: var(--line-strong); }
  .sibling--next { text-align: right; align-items: flex-end; }
  .sibling__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.3;
    transition: color .25s var(--ease);
  }
  .sibling:hover .sibling__title { color: var(--accent); }

  @media (max-width: 620px) {
    .siblings { grid-template-columns: 1fr; }
    .sibling--next { text-align: left; align-items: flex-start; }
  }
</style>
