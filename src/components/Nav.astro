---
const path = Astro.url.pathname;
const links = [
  { href: '/writing/',     label: 'Writing' },
  { href: '/open-source/', label: 'Open Source' },
  { href: '/about/',       label: 'About' },
  { href: '/contact/',     label: 'Contact' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="nav">
  <div class="shell nav__inner">
    <a href="/" class="brand" aria-label="fathomforge — home">
      <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true" fill="none">
        <!-- "The catch": a run rising, then held flat beneath a limit. The gap
             between the curve and the dashed cap is deliberately wide enough to
             survive at 16px, where a tighter one merges into a single smudge. -->
        <path d="M3 7h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="3 3.5" opacity=".55"/>
        <path d="M3 20c5-.5 8.5-2.5 11-5.5 1.7-2 3.1-3.5 4.8-3.5H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
      <span class="brand__word">fathomforge</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav__link', { 'is-active': isActive(l.href) }]}>
          {l.label}
        </a>
      ))}
    </nav>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light theme">
      <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true" fill="none"
           stroke="currentColor" stroke-width="1.6">
        <circle cx="12" cy="12" r="4.2"/>
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
              stroke-linecap="round"/>
      </svg>
      <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true" fill="none"
           stroke="currentColor" stroke-width="1.6">
        <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2Z" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  /** Keep the label describing the *destination*, not the current state. */
  const label = () => {
    if (!btn) return;
    const goingTo = root.dataset.theme === 'light' ? 'dark' : 'light';
    btn.setAttribute('aria-label', `Switch to ${goingTo} theme`);
    btn.setAttribute('title', `Switch to ${goingTo} theme`);
  };
  label();

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    label();
    try { localStorage.setItem('ff-theme', next); } catch (_) { /* non-fatal */ }
  });

  // Follow the OS only while the visitor has not chosen for themselves.
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem('ff-theme'); } catch (_) { /* ignore */ }
    if (saved) return;
    root.dataset.theme = e.matches ? 'light' : 'dark';
    label();
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 62px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
  }
  .brand__mark { width: 21px; height: 21px; color: var(--accent); flex: none; }
  .brand__word {
    font-family: var(--font-mono);
    font-size: .95rem;
    letter-spacing: -.01em;
  }
  .nav__links { display: flex; gap: 1.5rem; }
  .nav__link { white-space: nowrap; }
  .nav__link {
    font-size: .9rem;
    color: var(--fg-muted);
    text-decoration: none;
    padding-block: .3rem;
    position: relative;
    transition: color .25s var(--ease);
  }
  .nav__link:hover { color: var(--fg); }
  .nav__link.is-active { color: var(--fg); }
  .nav__link.is-active::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: var(--accent);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 34px; height: 34px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color .25s var(--ease), border-color .25s var(--ease);
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--line-strong); }
  .theme-toggle .icon { width: 16px; height: 16px; }
  /* Show the icon for the theme the button switches *to*. */
  .icon--moon { display: none; }
  :global(html[data-theme='light']) .icon--sun { display: none; }
  :global(html[data-theme='light']) .icon--moon { display: block; }

  /* Four links plus a brand and a toggle cannot share one row at 375px without
     wrapping mid-label, so the links drop to their own row and the header stops
     being sticky — a 100px sticky bar costs too much of a phone viewport. */
  @media (max-width: 660px) {
    .nav { position: static; }
    .nav__inner {
      flex-wrap: wrap;
      height: auto;
      row-gap: .1rem;
      padding-block: .7rem .2rem;
    }
    .nav__links {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: .75rem;
      padding-block: .55rem;
      border-top: 1px solid var(--line);
      margin-top: .6rem;
    }
    .nav__link { font-size: .85rem; white-space: nowrap; }
  }
</style>
